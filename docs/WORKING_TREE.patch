@@ -39,6 +39,157 @@ static SgsnInfoList_t sSgsnInfoList;
 typedef std::list<GmmInfo*> GmmInfoList_t;
 static GmmInfoList_t sGmmInfoList;
 static Mutex sSgsnListMutex;	// One lock sufficient for all lists maintained by SGSN.
+
+/*
+ * Experimental UMTS AKA bridge.
+ *
+ * Fetches one Milenage vector from OsmoHLR through
+ * /usr/local/bin/openbts-gsup-auth.
+ */
+static bool akaIsHex(const string &v)
+{
+	if (v.empty() || (v.size() & 1))
+		return false;
+
+	for (size_t i = 0; i < v.size(); ++i) {
+		char c = v[i];
+		if (!((c >= '0' && c <= '9') ||
+		      (c >= 'a' && c <= 'f') ||
+		      (c >= 'A' && c <= 'F')))
+			return false;
+	}
+
+	return true;
+}
+
+static bool akaExtract(const string &line, const char *name, string &value)
+{
+	string needle = string(name) + "=";
+	size_t p = line.find(needle);
+
+	if (p == string::npos)
+		return false;
+
+	p += needle.size();
+
+	size_t e = line.find_first_of(" \r\n\t", p);
+
+	if (e == string::npos)
+		e = line.size();
+
+	value = line.substr(p, e - p);
+	return !value.empty();
+}
+
+static bool akaHexEqual(const string &a, const string &b)
+{
+	if (a.size() != b.size())
+		return false;
+
+	for (size_t i = 0; i < a.size(); ++i) {
+		char ca = a[i];
+		char cb = b[i];
+
+		if (ca >= 'A' && ca <= 'F')
+			ca = ca - 'A' + 'a';
+
+		if (cb >= 'A' && cb <= 'F')
+			cb = cb - 'A' + 'a';
+
+		if (ca != cb)
+			return false;
+	}
+
+	return true;
+}
+
+static ByteVector akaHexToByteVector(const string &hex)
+{
+	ByteVector result(hex.size() / 2);
+
+	for (size_t i = 0; i < result.size(); ++i) {
+		unsigned value = 0;
+
+		for (unsigned n = 0; n < 2; ++n) {
+			char c = hex[i * 2 + n];
+			unsigned v;
+
+			if (c >= '0' && c <= '9')
+				v = c - '0';
+			else if (c >= 'a' && c <= 'f')
+				v = c - 'a' + 10;
+			else
+				v = c - 'A' + 10;
+
+			value = (value << 4) | v;
+		}
+
+		result.setByte(i, value);
+	}
+
+	return result;
+}
+
+static bool akaGetVector(
+	const string &imsi,
+	string &rand,
+	string &autn,
+	string &xres,
+	string &ck,
+	string &ik)
+{
+	/* IMSI comes from the UE, so do not put arbitrary text into a shell. */
+	if (imsi.empty() || imsi.size() > 15)
+		return false;
+
+	for (size_t i = 0; i < imsi.size(); ++i) {
+		if (imsi[i] < '0' || imsi[i] > '9')
+			return false;
+	}
+
+	string command =
+		"/usr/local/bin/openbts-gsup-auth " + imsi + " 2>/dev/null";
+
+	FILE *fp = popen(command.c_str(), "r");
+
+	if (!fp) {
+		LOG(ERR) << "Unable to start openbts-gsup-auth";
+		return false;
+	}
+
+	char buffer[1024];
+	string output;
+
+	while (fgets(buffer, sizeof(buffer), fp))
+		output += buffer;
+
+	int rc = pclose(fp);
+
+	if (rc != 0) {
+		LOG(ERR) << "openbts-gsup-auth failed for IMSI " << imsi;
+		return false;
+	}
+
+	if (!akaExtract(output, "RAND", rand) ||
+	    !akaExtract(output, "AUTN", autn) ||
+	    !akaExtract(output, "XRES", xres) ||
+	    !akaExtract(output, "CK", ck) ||
+	    !akaExtract(output, "IK", ik)) {
+		LOG(ERR) << "Malformed AKA helper output";
+		return false;
+	}
+
+	if (!akaIsHex(rand) || rand.size() != 32 ||
+	    !akaIsHex(autn) || autn.size() != 32 ||
+	    !akaIsHex(xres) || xres.size() < 8 || xres.size() > 32 ||
+	    !akaIsHex(ck)   || ck.size() != 32 ||
+	    !akaIsHex(ik)   || ik.size() != 32) {
+		LOG(ERR) << "Invalid UMTS AKA vector returned by helper";
+		return false;
+	}
+
+	return true;
+}
