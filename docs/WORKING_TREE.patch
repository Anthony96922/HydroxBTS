+void IntegrityProtect::setIK(std::string iks)
+{
+	if (iks.size() != 32) {
+		LOG(ERR) << "Invalid UMTS IK length: " << iks.size()
+		         << " hex characters (expected 32)";
+		return;
+	}
+
+	for (unsigned i = 0; i < 16; i++) {
+		std::string byte = iks.substr(i * 2, 2);
+		mIK[i] = (uint8_t)strtoul(byte.c_str(), NULL, 16);
+	}
+
+	LOG(INFO) << "Using native 128-bit UMTS IK";
+}
